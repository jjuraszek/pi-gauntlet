  "scoutPersona": "/abs/path/to/scout.md",
  "gauntletWorktree": "/abs/path/to/pi-gauntlet",
  "gauntletBaseCommit": "<sha>",
  "consumerRepo": "/abs/path/to/consumer-repo",
