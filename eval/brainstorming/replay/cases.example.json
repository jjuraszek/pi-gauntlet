    { "label": "P1", "ask": "<initial prompt verbatim>", "session": "relative/session.jsonl", "spec": "doc/specs/example.md", "base": "<sha>" },
    { "label": "P2", "ask": "<initial prompt verbatim>", "session": "relative/session.jsonl", "spec": "doc/specs/example.md", "base": "<sha>" },
    { "label": "N1", "ask": "<initial prompt verbatim>", "session": "relative/session.jsonl", "spec": "doc/specs/example.md", "base": "<sha>" }
  ]
